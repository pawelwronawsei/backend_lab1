@page
@model BackendLab01.Pages.QuizHub

@{
    ViewData["Title"] = "Dostępne quizy";
}

<h1>Dostępne quizy</h1>

@if (Model.QuizList.Count == 0)
{
    <p>Brak dostępnych quizów.</p>
}
else
{
    <ul>
        @foreach (var quiz in Model.QuizList)
        {
            <li>
                <a asp-page="Item" asp-route-quizId="@quiz.Id" asp-route-itemId="1">
                    @quiz.Title
                </a>
            </li>
        }
    </ul>
}