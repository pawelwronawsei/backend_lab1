@page "{quizId}"
@model BackendLab01.Pages.Summary
@{
    ViewData["Title"] = "Quiz Summary";
}

<h1>Podsumowanie quizu</h1>

<div class="card">
    <div class="card-body">
        <h2 class="card-title">Wynik</h2>
        <p><strong>Ilość pytań:</strong> @Model.TotalQuestions</p>
        <p><strong>Poprawne odpowiedzi:</strong> @Model.CorrectAnswersCount</p>
    </div>
</div>